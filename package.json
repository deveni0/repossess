{
  "name": "repossess",
  "version": "1.0.3",
  "description": "Use any GitHub repository as a full backend — collections, file uploads, and metadata with JSON or SQLite storage. No external database required.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "keywords": [
    "repossess",
    "repo",
    "github",
    "github-storage",
    "storage",
    "database",
    "collections",
    "json",
    "sqlite",
    "file-upload",
    "backend-as-a-service",
    "serverless",
    "typescript",
    "termux"
  ],
  "author": {
    "name": "YoussefvDev",
    "url": "https://github.com/deveni0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deveni0/repossess.git"
  },
  "bugs": {
    "url": "https://github.com/deveni0/repossess/issues"
  },
  "homepage": "https://github.com/deveni0/repossess#readme",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node example/index.js"
  }, 
  "dependencies": {
    "@octokit/rest": "^21.0.2",
    "zod": "^3.23.8",
    "nanoid": "^5.0.7",
    "p-limit": "^6.1.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.7.0"
  }
}